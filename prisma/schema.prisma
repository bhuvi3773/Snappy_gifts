// Snappy Gifts — Prisma Schema Draft (Batch 0 Foundation)
// Target Database: PostgreSQL 16+
// Standard: All monetary amounts stored as integer paise (BigInt / Int). Zero floating-point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  B2B_CLIENT
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_CUSTOMIZATION
  QUALITY_CHECK
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum OrderType {
  B2C
  B2B
}

enum QuotationStatus {
  DRAFT
  SENT_FOR_REVIEW
  APPROVED
  CONVERTED_TO_ORDER
  REJECTED
}

enum CorporateRole {
  OWNER
  REQUESTER
  APPROVER
  FINANCE
}

enum CorporateAccountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  phone           String?
  name            String
  passwordHash    String?
  role            Role           @default(CUSTOMER)
  isEmailVerified Boolean        @default(false)
  isActive        Boolean        @default(true)
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  addresses       Address[]
  orders          Order[]
  quotations      Quotation[]
  sessions        Session[]
  otpChallenges   OtpChallenge[]
  auditLogs       AuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  artworkUploads  ArtworkUpload[]
  corporateMemberships        CorporateMembership[]
  corporateRFQsCreated        CorporateRFQ[]                @relation("CorporateRFQsCreated")
  corporateQuotesCreated      CorporateQuote[]              @relation("CorporateQuotesCreated")
  corporateQuotesApproved     CorporateQuote[]              @relation("CorporateQuotesApproved")
  corporateOrderGroupsCreated CorporateOrderGroup[]         @relation("CorporateOrderGroupsCreated")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([sessionToken])
  @@index([userId])
}

model OtpChallenge {
  id          String   @id @default(uuid())
  email       String
  otpHash     String
  purpose     String   @default("LOGIN") // "LOGIN", "REGISTER", "PASSWORD_RESET"
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([email, purpose, isUsed])
}

model Organization {
  id                        String                 @id @default(uuid())
  companyName               String
  legalName                 String?
  displayName               String?
  gstin                     String?                @unique
  businessEmail             String
  contactPerson             String
  phone                     String
  industry                  String?
  annualBudget              String?
  status                    CorporateAccountStatus @default(PENDING_APPROVAL)
  creditLimitPaise          BigInt                 @default(0)
  creditUsedPaise           BigInt                 @default(0)
  isApproved                Boolean                @default(false)
  registeredAddress         Json?
  rejectionReason           String?
  reviewedBy                String?
  reviewedAt                DateTime?
  users                     User[]
  quotations                Quotation[]
  orders                    Order[]
  memberships               CorporateMembership[]
  corporateAddresses        CorporateAddress[]
  corporateRFQs             CorporateRFQ[]
  corporateQuotes           CorporateQuote[]
  corporatePriceAgreements  CorporatePriceAgreement[]
  corporateOrderGroups      CorporateOrderGroup[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([gstin])
  @@index([status])
}

model Address {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  company   String?
  street    String
  city      String
  state     String
  stateCode String   // e.g. "08" for Rajasthan
  pincode   String   // 6-digit Indian PIN code
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  tagline               String?
  description           String
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  occasions             String[]
  recipients            String[]
  hsnCode               String           // e.g. "69120010"
  taxRatePercent        Int              @default(18) // GST %
  basePricePaise        Int              // e.g. 129900 = ₹1,299.00
  mrpPaise              Int              // MRP in paise
  isCustomizable        Boolean          @default(false)
  customizationType     String?          // "engraving" | "photo" | "logo" | "combo"
  customizationFeePaise Int              @default(0)
  isB2BRecommended      Boolean          @default(false)
  minOrderQty           Int              @default(1)
  images                String[]
  galleryImages         ProductImage[]
  productOccasions      ProductOccasion[]
  isActive              Boolean          @default(true)
  isArchived            Boolean          @default(false)
  variants              ProductVariant[]
  bulkTiers             BulkTier[]
  corporatePriceAgreements CorporatePriceAgreement[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([categoryId])
  @@index([slug])
}

model Occasion {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?
  imageUrl    String?
  isActive    Boolean           @default(true)
  products    ProductOccasion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductOccasion {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, occasionId])
  @@index([occasionId])
  @@index([productId])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  storageKey   String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([productId, displayOrder])
}

model ProductVariant {
  id                   String                @id @default(uuid())
  productId            String
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String                @unique
  name                 String
  attributes           Json
  pricePaise           Int                   // Paise
  stockQuantity        Int                   @default(0)
  isActive             Boolean               @default(true)
  isArchived           Boolean               @default(false)
  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([sku])
  @@index([productId])
}

enum InventoryAdjustmentReason {
  RESTOCK
  MANUAL_CORRECTION
  DAMAGE_WRITE_OFF
  RETURN_RESTOCK
  ORDER_RESERVATION
  RESERVATION_EXPIRED
  ORDER_FULFILLMENT
  AUDIT_RECONCILIATION
}

model InventoryAdjustment {
  id            String                    @id @default(uuid())
  variantId     String
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku           String                    // Immutable SKU snapshot at time of adjustment
  productName   String?                   // Product name snapshot
  previousStock Int
  adjustedQty   Int                       // Signed delta: +50, -10
  newStock      Int                       // Balance after adjustment
  reason        InventoryAdjustmentReason @default(MANUAL_CORRECTION)
  referenceId   String?                   // e.g. PO number, Batch ID, Order ID
  userId        String?
  user          User?                     @relation(fields: [userId], references: [id])
  notes         String?
  createdAt     DateTime                  @default(now())

  @@index([variantId])
  @@index([createdAt])
  @@index([reason])
}

model BulkTier {
  id                 String  @id @default(uuid())
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty             Int
  maxQty             Int?
  discountPercentage Int
  pricePerUnitPaise  Int     // Paise
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique // e.g. "SG-2026-10492"
  type                 OrderType     @default(B2C)
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id])
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id])
  
  customerName         String
  customerEmail        String
  customerPhone        String
  gstin                String?
  
  shippingAddress      Json
  destinationStateCode String
  
  // Financial Totals in Integer Paise
  itemsSubtotalPaise      BigInt
  customizationTotalPaise BigInt        @default(0)
  discountTotalPaise      BigInt        @default(0)
  taxableAmountPaise      BigInt
  taxTotalPaise           BigInt
  cgstPaise               BigInt        @default(0)
  sgstPaise               BigInt        @default(0)
  igstPaise               BigInt        @default(0)
  shippingTotalPaise      BigInt        @default(0)
  grandTotalPaise         BigInt
  
  orderStatus          OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)
  paymentMethod        String
  
  idempotencyKey       String?       @unique
  reservationExpiresAt DateTime?
  guestLookupToken     String?
  
  items                OrderItem[]
  payments             Payment[]
  shipments            Shipment[]
  statusHistory        OrderStatusHistory[]
  invoices             Invoice[]
  corporateOrderGroupId       String?
  corporateOrderGroup         CorporateOrderGroup?         @relation(fields: [corporateOrderGroupId], references: [id])
  corporateDeliveryAllocation CorporateDeliveryAllocation?
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([orderStatus])
  @@index([reservationExpiresAt])
  @@index([corporateOrderGroupId])
}

model OrderItem {
  id                    String          @id @default(uuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId             String?
  variant               ProductVariant? @relation(fields: [variantId], references: [id])
  
  // Historical Snapshot
  productName           String
  sku                   String
  hsnCode               String
  taxRatePercent        Int
  unitPricePaise        Int
  quantity              Int
  subtotalPaise         BigInt
  
  isCustomized          Boolean         @default(false)
  customizationNote     String?
  customizationFeePaise Int             @default(0)
  proofImageUrl         String?
  customizationMeta     Json?
  personalization       OrderPersonalization?
  
  createdAt             DateTime        @default(now())

  @@index([orderId])
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  gateway          String        // "RAZORPAY" | "MOCK"
  gatewayOrderId   String
  gatewayPaymentId String?
  gatewaySignature String?
  amountPaise      BigInt
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  capturedAt       DateTime?
  errorMessage     String?
  idempotencyKey   String?       @unique
  rawEventPayload  Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  gateway     String   // "RAZORPAY"
  eventId     String   @unique
  eventType   String   // "payment.captured", "payment.failed", "order.paid"
  payloadHash String   // SHA-256 of raw request body
  status      String   @default("PROCESSED") // "PROCESSED", "IGNORED", "FAILED", "RECONCILIATION_REQUIRED"
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

model PaymentReconciliation {
  id                  String   @id @default(uuid())
  orderId             String?
  orderNumber         String?
  gatewayPaymentId    String
  gatewayOrderId      String?
  expectedAmountPaise BigInt?
  receivedAmountPaise BigInt
  discrepancyType     String   // "LATE_PAYMENT_EXPIRED_HOLD", "AMOUNT_MISMATCH", "UNKNOWN_ORDER", "UNAUTHORIZED_CURRENCY"
  status              String   @default("OPEN") // "OPEN", "RESOLVED", "REFUNDED"
  notes               String?
  rawEvent            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([gatewayPaymentId])
  @@index([orderNumber])
  @@index([status])
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipientName  String
  recipientEmail String?
  recipientPhone String
  addressStreet  String
  city           String
  state          String
  pincode        String
  carrierPartner String?
  awbNumber      String?   @unique
  trackingUrl    String?
  dispatchStatus            String    @default("PENDING")
  dispatchedAt              DateTime?
  deliveredAt               DateTime?
  invoicePhysicallySignedBy String?
  invoicePhysicallySignedAt DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([orderId])
  @@index([awbNumber])
}

model Quotation {
  id                        String          @id @default(uuid())
  rfqNumber                 String          @unique
  userId                    String?
  user                      User?           @relation(fields: [userId], references: [id])
  organizationId            String?
  organization              Organization?   @relation(fields: [organizationId], references: [id])
  companyName               String
  contactPerson             String
  email                     String
  phone                     String
  gstin                     String
  itemsJson                 Json
  subtotalPaise             BigInt
  negotiatedDiscountPercent Int             @default(0)
  taxAmountPaise            BigInt
  shippingAmountPaise       BigInt          @default(0)
  grandTotalPaise           BigInt
  validUntil                DateTime
  status                    QuotationStatus @default(DRAFT)
  paymentTerms              String          @default("100% Advance")
  notes                     String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@index([rfqNumber])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  changedBy  String
  notes      String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ArtworkUpload {
  id                 String                 @id @default(uuid())
  fileKey            String                 @unique // Cryptographic storage identifier (e.g., "proofs/timestamp-hash.png")
  originalFilename   String
  mimeType           String
  sizeBytes          Int
  fileHash           String?                // SHA-256 hash of raw binary buffer
  storageFolder      String                 @default("proofs")
  uploadedByUserId   String?
  user               User?                  @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  guestSessionToken  String?                // Ephemeral guest authorization token
  status             String                 @default("ACTIVE") // "ACTIVE", "ATTACHED", "ABANDONED"
  expiresAt          DateTime?              // Lifecycle policy for unattached uploads
  personalizations   OrderPersonalization[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([fileKey])
  @@index([uploadedByUserId])
  @@index([guestSessionToken])
  @@index([status])
}

model OrderPersonalization {
  id                    String         @id @default(uuid())
  orderItemId           String         @unique
  orderItem             OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  personalizationType   String         @default("TEXT_ENGRAVING") // "TEXT_ENGRAVING", "PHOTO_PRINT", "LOGO_BRANDING", "BESPOKE_COMBO"
  engravedText          String?
  fontFamily            String?
  giftNote              String?
  ribbonColor           String?
  boxWrapStyle          String?
  waxSealColor          String?
  artworkUploadId       String?
  artworkUpload         ArtworkUpload? @relation(fields: [artworkUploadId], references: [id], onDelete: SetNull)
  cropSettings          Json?          // { x: number, y: number, width: number, height: number, zoom: number, rotation: number }
  placementSettings     Json?          // { position: string, scale: number, offsetX: number, offsetY: number }
  proofImageUrl         String?        // Private preview proof asset identifier
  proofAssetKey         String?        // Storage key in storage/private/proofs/
  proofVersion          Int            @default(1)
  
  // Backward-compatible aggregated status
  approvalStatus        String         @default("APPROVED_BY_CUSTOMER") // "DRAFT", "APPROVED_BY_CUSTOMER", "ARTWORK_VERIFIED_BY_STAFF", "REJECTED_FOR_REWORK"
  approvedAt            DateTime?
  approvedBy            String?        // Primary auditor / approver
  
  // Unambiguous Customer Approval Record
  customerApprovalStatus String        @default("PENDING") // "PENDING", "APPROVED"
  customerApprovedAt     DateTime?
  customerApprovedBy     String?       // Customer email or authenticated session
  
  // Unambiguous Artisan / Staff Review Record
  staffReviewStatus      String        @default("PENDING_REVIEW") // "PENDING_REVIEW", "ARTWORK_VERIFIED_BY_STAFF", "REJECTED_FOR_REWORK"
  staffReviewedAt        DateTime?
  staffReviewedBy        String?       // Authorized staff member identifier
  
  customizationFeePaise Int            @default(0)
  staffNotes            String?
  metadata              Json?          // Technical laser specs & coordinates
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([orderItemId])
  @@index([artworkUploadId])
  @@index([approvalStatus])
  @@index([customerApprovalStatus])
  @@index([staffReviewStatus])
}

model Invoice {
  id                      String    @id @default(uuid())
  invoiceNumber           String    @unique // e.g. "SG/26-27/0001" (<= 16 characters)
  orderId                 String
  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber             String
  invoiceDate             DateTime  @default(now())
  financialYear           String    // e.g. "2026-27"
  series                  String    @default("SG")
  sequenceNumber          Int
  
  // Supplier Snapshot
  supplierLegalName       String
  supplierTradeName       String?
  supplierGstin           String
  supplierAddress         Json
  supplierState           String
  supplierStateCode       String    // e.g. "08"
  
  // Recipient Snapshot
  customerName            String
  customerEmail           String
  customerPhone           String?
  customerGstin           String?
  billingAddress          Json
  shippingAddress         Json
  placeOfSupply           String
  placeOfSupplyStateCode  String
  isIntraState            Boolean
  
  // Financial Snapshot in Integer Paise
  itemsSubtotalPaise      BigInt
  customizationTotalPaise BigInt    @default(0)
  discountTotalPaise      BigInt    @default(0)
  taxableAmountPaise      BigInt
  cgstPaise               BigInt    @default(0)
  sgstPaise               BigInt    @default(0)
  igstPaise               BigInt    @default(0)
  taxTotalPaise           BigInt
  shippingTotalPaise      BigInt    @default(0)
  grandTotalPaise         BigInt
  
  // Line items detailed JSON snapshot
  itemsJson               Json
  pdfStorageKey           String?   // Private storage key in storage/private/invoices/
  pdfGeneratedAt          DateTime?
  isSample                Boolean   @default(false)
  status                  String    @default("ISSUED") // "ISSUED", "CANCELLED", "PROVISIONAL"
  
  // E-Invoicing & Signature Compliance Snapshots (Rule 46 & Rule 48(4))
  eInvoiceStatus               String    @default("PENDING_ACCOUNTANT_CONFIRMATION")
  irn                          String?   // 64-character hash from IRP
  signedQrData                 String?   // JWT signed QR payload from IRP
  rule46Declaration            String?   // Rule 46(s) declaration where aggregate turnover > 5Cr but exempt
  signatureMode                String    @default("PHYSICAL_SIGNATURE_ON_PRINT")
  physicalSignatureConfirmedBy String?
  physicalSignatureConfirmedAt DateTime?

  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([financialYear, series, sequenceNumber])
  @@index([orderId])
  @@index([orderNumber])
  @@index([financialYear])
}

model InvoiceSequence {
  id              String   @id @default(uuid())
  financialYear   String   // e.g. "2026-27"
  series          String   @default("SG")
  currentSequence Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([financialYear, series])
}

model EmailOutbox {
  id                 String    @id @default(uuid())
  idempotencyKey     String    @unique
  eventType          String    // "ORDER_CONFIRMATION", "INVOICE_AVAILABLE", "SHIPMENT_DISPATCHED"
  orderId            String?
  orderNumber        String?
  recipientEmail     String
  recipientName      String?
  subject            String
  htmlBody           String
  textBody           String?
  attachmentKey      String?
  attachmentFilename String?
  status             String    @default("PENDING") // "PENDING", "PROCESSING", "SENT", "FAILED"
  attempts           Int       @default(0)
  maxAttempts        Int       @default(5)
  lastError          String?
  nextRetryAt        DateTime?
  lockedAt           DateTime?
  lockedBy           String?
  sentAt             DateTime?
  messageId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderNumber])
  @@index([idempotencyKey])
}

model SellerConfig {
  id                                           String    @id @default("default")
  legalName                                    String
  tradeName                                    String?
  gstin                                        String
  pan                                          String?
  registeredStreet                             String
  city                                         String
  state                                        String    @default("Rajasthan")
  stateCode                                    String    @default("08")
  pincode                                      String
  contactEmail                                 String
  contactPhone                                 String
  invoicePrefix                                String    @default("SG")
  authorizedSignatoryName                      String?
  authorizedSignatoryDesignation               String?
  invoiceFooterTerms                           String?
  isVerified                                   Boolean   @default(false)

  // E-Invoicing Applicability (CGST Rule 48(4) & Rule 46(s))
  // Status: "PENDING_ACCOUNTANT_CONFIRMATION", "EXEMPT_BELOW_THRESHOLD", "EXEMPT_NOTIFIED_CATEGORY", "APPLICABLE"
  eInvoiceStatus                               String    @default("PENDING_ACCOUNTANT_CONFIRMATION")
  eInvoiceExemptionReason                      String?
  eInvoiceConfirmedBy                          String?   // Name & CA membership/ARN of accountant who verified turnover
  eInvoiceConfirmedAt                          DateTime?
  panAggregateTurnoverExceeds5Cr               Boolean   @default(false)
  
  // Signature Compliance Mode (CGST Rule 46(q))
  // Mode: "PHYSICAL_SIGNATURE_ON_PRINT", "DIGITAL_SIGNATURE_IT_ACT", "ELECTRONIC_INVOICE_EXCEPTION", "E_INVOICE_IRP_QR"
  signatureMode                                String    @default("PHYSICAL_SIGNATURE_ON_PRINT")
  digitalSignatureConfigured                   Boolean   @default(false)
  electronicInvoiceSignatureExemptionConfirmed Boolean   @default(false)
  electronicInvoiceExemptionConfirmedBy        String?
  electronicInvoiceExemptionConfirmedAt        DateTime?

  updatedAt                                    DateTime  @updatedAt
  updatedBy                                    String?
}

// =============================================================
// Batch 9A: Corporate B2B Portal, RFQ, Pricing & Multi-Address
// =============================================================

model CorporateMembership {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           CorporateRole  @default(REQUESTER)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model CorporateAddress {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  recipientName  String
  recipientPhone String
  recipientEmail String?
  street         String
  city           String
  state          String
  stateCode      String
  pincode        String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([pincode])
}

model CorporateRFQ {
  id                     String             @id @default(uuid())
  rfqNumber              String             @unique // e.g. "CRFQ-2026-0001"
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById            String
  createdBy              User               @relation("CorporateRFQsCreated", fields: [createdById], references: [id])
  title                  String
  status                 String             @default("SUBMITTED") // "DRAFT", "SUBMITTED", "UNDER_REVIEW", "QUOTED", "ACCEPTED", "REJECTED", "CANCELLED", "EXPIRED"
  requiredDeliveryDate   DateTime?
  estimatedBudgetPaise   BigInt?
  numberOfLocations      Int                @default(1)
  packagingRequirements  String?
  brandingRequirements   String?
  additionalInstructions String?
  customerNotes          String?
  internalAdminNotes     String?
  reviewedById           String?
  reviewedAt             DateTime?
  rejectionReason        String?
  items                  CorporateRFQItem[]
  quotes                 CorporateQuote[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([organizationId])
  @@index([rfqNumber])
  @@index([status])
}

model CorporateRFQItem {
  id                       String       @id @default(uuid())
  rfqId                    String
  rfq                      CorporateRFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId                String
  variantId                String?
  productName              String
  variantName              String?
  sku                      String
  requestedQuantity        Int
  personalizationNote      String?
  logoUrl                  String?
  estimatedUnitBudgetPaise BigInt?

  @@index([rfqId])
  @@index([productId])
}

model CorporateQuote {
  id                      String               @id @default(uuid())
  quoteNumber             String               // e.g. "QT-2026-0001"
  revision                Int                  @default(1)
  isLatestRevision        Boolean              @default(true)
  rfqId                   String?
  rfq                     CorporateRFQ?        @relation(fields: [rfqId], references: [id])
  organizationId          String
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById             String
  createdBy               User                 @relation("CorporateQuotesCreated", fields: [createdById], references: [id])
  status                  String               @default("DRAFT") // "DRAFT", "ISSUED", "ACCEPTED", "REJECTED", "SUPERSEDED", "EXPIRED"
  validUntil              DateTime
  itemsSubtotalPaise      BigInt
  customizationTotalPaise BigInt               @default(0)
  discountTotalPaise      BigInt               @default(0)
  taxableAmountPaise      BigInt
  taxTotalPaise           BigInt
  cgstPaise               BigInt               @default(0)
  sgstPaise               BigInt               @default(0)
  igstPaise               BigInt               @default(0)
  shippingTotalPaise      BigInt               @default(0)
  grandTotalPaise         BigInt
  commercialTerms         String?
  customerNotes           String?
  internalAdminNotes      String?
  approvedById            String?
  approvedBy              User?                @relation("CorporateQuotesApproved", fields: [approvedById], references: [id])
  approvedAt              DateTime?
  rejectedById            String?
  rejectedAt              DateTime?
  rejectionReason         String?
  items                   CorporateQuoteItem[]
  corporateOrderGroup     CorporateOrderGroup?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([quoteNumber, revision])
  @@index([organizationId])
  @@index([quoteNumber])
  @@index([rfqId])
  @@index([status])
}

model CorporateQuoteItem {
  id                     String         @id @default(uuid())
  quoteId                String
  quote                  CorporateQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId              String
  variantId              String?
  productName            String
  variantName            String?
  sku                    String
  hsnCode                String
  taxRatePercent         Int
  quantity               Int
  unitPricePaise         Int
  customizationFeePaise  Int            @default(0)
  discountPercent        Int            @default(0)
  lineSubtotalPaise      BigInt
  lineTaxPaise           BigInt
  lineTotalPaise         BigInt
  personalizationDetails Json?

  @@index([quoteId])
  @@index([sku])
}

model CorporatePriceAgreement {
  id                String               @id @default(uuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  agreementName     String
  unitPricePaise    Int
  effectiveFrom     DateTime
  effectiveTo       DateTime
  isActive          Boolean              @default(true)
  negotiatedBy      String
  negotiationReason String?
  tiers             CorporatePriceTier[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([organizationId])
  @@index([productId])
  @@index([isActive])
}

model CorporatePriceTier {
  id             String                  @id @default(uuid())
  agreementId    String
  agreement      CorporatePriceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  minQuantity    Int
  maxQuantity    Int?
  unitPricePaise Int

  @@index([agreementId])
}

model CorporateOrderGroup {
  id                  String                        @id @default(uuid())
  groupOrderNumber    String                        @unique // e.g. "CORP-2026-9001"
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id])
  quoteId             String?                       @unique
  quote               CorporateQuote?               @relation(fields: [quoteId], references: [id])
  createdById         String
  createdBy           User                          @relation("CorporateOrderGroupsCreated", fields: [createdById], references: [id])
  totalDestinations   Int
  totalQuantity       Int
  grandTotalPaise     BigInt
  paymentStatus       PaymentStatus                 @default(PENDING)
  paymentMethod       String                        @default("ONLINE_UPI")
  paymentReference    String?
  orders              Order[]
  deliveryAllocations CorporateDeliveryAllocation[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([organizationId])
  @@index([groupOrderNumber])
}

model CorporateDeliveryAllocation {
  id                  String              @id @default(uuid())
  orderGroupId        String
  orderGroup          CorporateOrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  childOrderId        String?             @unique
  childOrder          Order?              @relation(fields: [childOrderId], references: [id])
  recipientName       String
  recipientPhone      String
  recipientEmail      String?
  street              String
  city                String
  state               String
  stateCode           String
  pincode             String
  department          String?
  customGiftNote      String?
  quantity            Int
  productId           String
  variantId           String?
  sku                 String
  allocatedTotalPaise BigInt
  shipmentStatus      String              @default("PENDING")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([orderGroupId])
  @@index([pincode])
}

// =============================================================
// Batch 10: Store Settings, Operations & Administration
// =============================================================

model StoreConfig {
  id                         String   @id @default("default")
  storeName                  String   @default("Snappy Gifts")
  supportEmail               String   @default("support@snappygifts.in")
  supportPhone               String   @default("+91 145 200 1234")
  operatingHours             String   @default("Mon-Sat 9:30 AM - 6:30 PM IST")
  headquartersAddress        String   @default("Ajmer Central Gifting Hub, Rajasthan - 305001")
  
  // Shipping Configuration (Paise)
  standardShippingFeePaise   BigInt   @default(9900)
  freeShippingThresholdPaise BigInt   @default(99900)
  expressShippingFeePaise    BigInt   @default(19900)
  shippingInstructions       String?
  
  // Inventory Alert Thresholds
  lowStockThreshold          Int      @default(100)
  outOfStockThreshold        Int      @default(0)
  autoNotifyLowStock         Boolean  @default(true)
  
  // Personalization Configuration
  allowCustomText            Boolean  @default(true)
  allowArtworkUpload         Boolean  @default(true)
  maxArtworkUploadBytes      Int      @default(5242880)
  woodenCrateSurchargePaise  BigInt   @default(15000)
  
  updatedAt                  DateTime @updatedAt
  updatedBy                  String?
}

