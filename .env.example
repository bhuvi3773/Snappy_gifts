# ===================================================
# Snappy Gifts — Environment Variable Configuration
# IMPORTANT: Never commit real secrets or production keys.
# Copy this file to .env.local for local development.
# ===================================================

# Application Environment
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Local PostgreSQL Database (Docker Compose)
DATABASE_URL="postgresql://snappy_user:snappy_dev_password_only@localhost:5432/snappy_gifts_db?schema=public"
DIRECT_URL="postgresql://snappy_user:snappy_dev_password_only@localhost:5432/snappy_gifts_db?schema=public"

# Auth.js / NextAuth Session Secret (Generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="dev_insecure_secret_for_local_development_only_replace_in_prod"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay Payment Gateway (Test Mode / Sandbox)
# Obtain test credentials from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Local Transactional Email (Mailpit via Docker Compose)
# Web UI: http://localhost:8025 | SMTP: localhost:1025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="orders@snappygifts.in"

# Secure Private File Storage (Local Disk / S3 Placeholder)
STORAGE_PROVIDER="local" # "local" for dev, "s3" for prod
STORAGE_BUCKET="snappy-gifts-private-uploads"

# Personalization & Packaging Surcharges (Integer Paise: 100 paise = ₹1.00)
# Default for Vintage Wooden Keepsake Crate: 15000 paise (₹150.00)
# Set to 'true' only after formal store owner written approval
WOODEN_CRATE_SURCHARGE_PAISE="15000"
WOODEN_CRATE_SURCHARGE_APPROVED="false"

# Distributed Rate Limiting & Abuse Prevention (Upstash Redis)
# Required in production to enforce multi-instance rate limits across serverless instances
# In dev/test, defaults to in-memory adapter; production strictly fails closed if unconfigured
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_BACKEND="memory" # "memory" for dev/test, "upstash" for prod
